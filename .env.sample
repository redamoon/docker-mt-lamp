MYSQL_ALLOW_EMPTY_PASSWORD=yes
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=movabletype
MYSQL_USER=movabletype
MYSQL_PASSWORD=movabletype
CONTAINER_BASE_NAME=website
CGI_BASE_PATH=/var/www/local/cgi-bin
DUMP_FILE=test_data_mysql
WEB_PORT=11000:80
APP_PORT=5000
DB_PORT=3306:3306
WORK_DIR=/var/www/mt
MT=MT7-R5402
# cgi（現行 Apache CGI・デフォルト） / psgi-dev（plackup） / psgi（Apache リバースプロキシ + Starman）
COMPOSE_PROFILES=cgi
# psgi モードの Starman ワーカー数（未検証の本番構成。必要なら変更）
STARMAN_WORKERS=2
